ERP_MYSQL_HOST=127.0.0.1
ERP_MYSQL_PORT=3307
ERP_MYSQL_DATABASE=lite_erp
ERP_MYSQL_USER=lite_erp
ERP_MYSQL_PASSWORD=LiteErp@2026!

# JWT 签名密钥：生产环境（ERP_ENV=production）必须设置，否则后端拒绝启动。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# ERP_JWT_SECRET=

# 运行模式（run.py 会自动设置，手工启动时请显式声明）：dev 允许临时随机密钥，
# production 强制要求 ERP_JWT_SECRET。
# ERP_ENV=dev

# Break-glass 应急管理员：默认关闭。三项必须同时设置，且密码不少于 12 位，
# 缺失或强度不足时应急账号一律不启用。每次应急登录都会写入独立审计日志。
# ERP_ENABLE_EMERGENCY_ADMIN=1
# ERP_EMERGENCY_ADMIN_USER=emergency_admin
# ERP_EMERGENCY_ADMIN_PASSWORD=
